# Public URLs
# Keep the app on the apex host until HTTPS is added, because the frontend
# bakes NEXT_PUBLIC_API_URL into the client bundle and the backend CORS config
# only accepts one http origin via FRONTEND_URL.
FRONTEND_URL=http://carta.cz
NEXT_PUBLIC_API_URL=http://carta.cz/api

# Backend secrets and mail metadata
JWT_SECRET=replace-with-a-long-random-secret
EMAIL_FROM="Carta.cz <noreply@carta.cz>"

# Neon PostgreSQL connection string used by Prisma.
# Use the direct Neon connection string here so `prisma migrate deploy` can run
# from the backend container without depending on a local Postgres service.
DATABASE_URL=postgresql://neon-user:neon-password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional notification hook used by the contact form.
DISCORD_WEBHOOK_URL=

# Supabase is only used for image storage in the current backend.
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
