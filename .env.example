# Public URLs
# Keep the app on the apex host until HTTPS is added, because the frontend
# bakes NEXT_PUBLIC_API_URL into the client bundle and the backend CORS config
# only accepts one http origin via FRONTEND_URL.
FRONTEND_URL=http://carta.cz
NEXT_PUBLIC_API_URL=http://carta.cz/api

# Backend secrets and mail metadata
JWT_SECRET=replace-with-a-long-random-secret
EMAIL_FROM="Carta.cz <noreply@carta.cz>"

# Postgres used by the Docker stack.
# For local Docker, the default compose network hostname is `postgres`.
# On a remote host you can either keep the bundled Postgres container or
# override DATABASE_URL with an external Postgres instance.
POSTGRES_DB=carta
POSTGRES_USER=carta
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://carta:replace-with-a-strong-password@postgres:5432/carta?schema=public

# Optional notification hook used by the contact form.
DISCORD_WEBHOOK_URL=
