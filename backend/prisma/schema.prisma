generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  name             String
  isDealer         Boolean   @default(false)
  ads              Ad[]
  savedAds         SavedAd[]
  reviewsWritten   Review[]
  reviewsReceived  Review[]  @relation("TargetReviews")
  createdAt        DateTime  @default(now())
}

model Ad {
  id                  String         @id @default(uuid())
  title               String
  brand               String         // <-- přidej toto
  model               String
  description         String
  price               Int
  mileage             Int
  year                Int?
  firstRegistration   Int?
  bodyType            BodyType
  doorCount           Int
  seatCount           Int
  color               String
  colorFinish         String?
  airbagCount         Int
  airConditioning     AirConditioning
  fuel                FuelType
  engineVolume        Int
  power               Int
  avgConsumption      Float?
  transmission        Transmission
  gearCount           Int?
  drivetrain          Drivetrain
  condition           CarCondition
  technicalCheckUntil DateTime?
  countryOfOrigin     String
  euroStandard        EmissionClass
  ecoTaxPaid          Boolean
  isFirstOwner        Boolean
  isDisabledAdapted   Boolean
  wasCrashed          Boolean
  hasServiceBook      Boolean
  warrantyUntil       DateTime?
  windowNote          String?
  features            CarFeature[]   @relation("AdFeatures")
  images              Image[]
  savedBy             SavedAd[]
  user                User           @relation(fields: [userId], references: [id])
  userId              String
  createdAt           DateTime       @default(now())
  expiresAt           DateTime?
  isVisible           Boolean        @default(true)
  views               Int            @default(0)
  image_url           String?
}

model CarFeature {
  id    String @id @default(uuid())
  name  String @unique
  ads   Ad[]   @relation("AdFeatures")
}

model Image {
  id    String @id @default(uuid())
  url   String
  ad    Ad     @relation(fields: [adId], references: [id])
  adId  String
}

model Review {
  id        String   @id @default(uuid())
  rating    Int      // 1–5
  comment   String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  target    User     @relation("TargetReviews", fields: [targetId], references: [id])
  targetId  String
  createdAt DateTime @default(now())

  @@unique([userId, targetId])
}

model SavedAd {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  ad        Ad       @relation(fields: [adId], references: [id])
  adId      String
  createdAt DateTime @default(now())

  @@unique([userId, adId])
}

// ---------- ENUMS ----------

enum BodyType {
  hatchback
  sedan
  kombi
  suv
  coupe
  cabrio
  mpv
  pickup
  van
  jiné
}

enum AirConditioning {
  none
  manual
  automatic
  two_zone
  three_zone
}

enum FuelType {
  petrol
  diesel
  hybrid
  electric
  lpg
  cng
}

enum Transmission {
  manual
  automatic
  semi_automatic
}

enum Drivetrain {
  fwd
  rwd
  awd
  four_x_four
}

enum EmissionClass {
  euro1
  euro2
  euro3
  euro4
  euro5
  euro6
  euro6d
}

enum CarCondition {
  new
  used
  crashed
  demo
}
