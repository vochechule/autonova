// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String
  createdAt DateTime @default(now())
  ads      Ad[]
}

// prisma/schema.prisma
model Ad {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Int
  mileage     Int
  year        Int
  fuel        String?
  body        String?
  color       String?
  vin         String?
  transmission String?
  power       Int?     // kW
  engineSize  Float?   // litry
  doors       Int?
  seats       Int?
  drive       String?  // např. "FWD", "AWD", "RWD"
  country     String?  // země původu
  condition   String?  // např. "jako nové", "bourané", "opotřebované"
  location   String?  // město nebo region

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  userId      Int

  photos      Photo[]
}

model Photo {
  id     Int    @id @default(autoincrement())
  url    String
  adId   Int
  ad     Ad     @relation(fields: [adId], references: [id])
}
